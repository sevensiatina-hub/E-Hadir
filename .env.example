# GEMINI_API_KEY: Disediakan secara automatik oleh persekitaran AI Studio jika diperlukan.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL hos aplikasi untuk rujukan dalaman dan pautan luar.
APP_URL="MY_APP_URL"

